{
  "expo": {
    "name": "CUTAMORA_D",
    "slug": "cutamora-d",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/daisy-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFB6C1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cutamora.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/daisy-adaptive-icon.png",
        "backgroundColor": "#FFB6C1"
      },
      "package": "com.cutamora.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "10253b0e-8761-4e06-be91-5c88a8778440"
      }
    }
  }
}
