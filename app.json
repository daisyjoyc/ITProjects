{
  "expo": {
    "name": "Autentico_MJ",
    "slug": "Autentico_MJ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mj_icon.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/mj_icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mj_icon.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.daisyjoy.autenticomj"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "a9663903-763b-495c-bd6f-b06b5604925c"
      }
    }
  }
}
